# Server
PORT=5000
NODE_ENV=development

# Vercel Postgres (powered by Neon)
# Get this from: Vercel Dashboard → Storage → your database → .env.local tab
# It looks like: postgres://user:pass@host/dbname?sslmode=require
POSTGRES_URL=

# Client URL (React app)
CLIENT_URL=http://localhost:5173

# Session secret (change in production)
SESSION_SECRET=replace-me-session-secret

# JWT secret (change in production)
JWT_SECRET=replace-me-jwt-secret

# Google OAuth 2.0 credentials
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials
# 3. Create an OAuth 2.0 Client ID (Web Application)
# 4. Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Calendar sync uses a separate callback and a least-privilege scope.
# Enable the Google Calendar API, then add this exact URI as a SECOND authorized
# redirect URI on the same OAuth web client. Registering only GOOGLE_CALLBACK_URL
# causes Google to reject Calendar connections with redirect_uri_mismatch.
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/user/calendar/google/callback

# Random secret (at least 32 characters) used to encrypt stored Google refresh tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_CALENDAR_TOKEN_SECRET=replace-me-with-a-long-random-secret
